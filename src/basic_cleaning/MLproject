name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: Name of sample to download
        type: string

      artifact_name:
        description: Name for the output artifact
        type: string

      artifact_type: 
        description: Type of the output artifact
        type: string

      artifact_description: 
        description: A brief description of the output artifact
        type: string

      min_price:
        description: Minimum price
        type: integer

      max_price:
        description: Maximum price
        type: integer

    command: "python run.py {input_artifact} {artifact_name} {artifact_type} {artifact_description} --min_price {min_price} --max_price {max_price}"
